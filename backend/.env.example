PORT=3001
NODE_ENV=development

# Required in production (use long random values)
JWT_SECRET=change-me-in-production
API_KEY=change-me-service-key
ADMIN_INITIAL_PASSWORD=change-me-on-first-production-bootstrap
# Optional: allow self-registration into one shared workspace. Empty = personal workspace per signup.
PUBLIC_REGISTRATION_WORKSPACE_ID=

# Reverse proxy / browser policy
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# DeepSeek / OpenAI-compatible provider (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
LLM_TEMPERATURE=0.18
LLM_TIMEOUT_MS=45000

# AI is explicit. Offline AI is an optional extension and is disabled by default.
AI_EXECUTION_MODE=hybrid
OFFLINE_AI_ENABLED=0
OFFLINE_AI_URL=http://127.0.0.1:5005
OFFLINE_AI_KEY=change-me-offline-key
OFFLINE_AI_TIMEOUT_MS=12000

# Optional custom database path
# SQLITE_PATH=/var/lib/graph-platform/graph.db
